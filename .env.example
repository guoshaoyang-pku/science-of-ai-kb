# These are optional shell environment overrides; no dotenv loader is required.
# Copy eval_keys.example.json to a PRIVATE file, fill in your own endpoint/key,
# then export KB_EVAL_KEYS=/absolute/path/to/your/private/eval_keys.json.
KB_EVAL_KEYS=aiq_bench_repo/data/evals/eval_keys.json
KB_SITE_ORIGIN=https://your-username.github.io/

# Optional PyTorch execution controls (defaults used by the runtime are 4/0/1).
ARCHITECTURE_IQ_TORCH_THREADS=4
ARCHITECTURE_IQ_SEED_WORKERS=0
ARCHITECTURE_IQ_SEED_TORCH_THREADS=1
# setup.sh can select an installed Python via KB_PYTHON.
KB_PYTHON=python3
# CODEX_HOME is managed per job by the Codex adapter; do not copy a login home.
